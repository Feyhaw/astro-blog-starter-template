---
import { siteMap } from '../data/siteMap';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const currentEntry = Object.entries(siteMap).find(
    ([, page]) => {
    const pagePath = page.path.replace(/\/$/, '') || '/';
    return pagePath === currentPath;
    }
);

const currentPage = currentEntry?.[1];
const neighbours = currentPage?.neighbours ?? {};
---

<nav class="edge-nav" aria-label="Spatial navigation">
    {
        Object.entries(neighbours).map(([direction, key]) => {
            const target =
                siteMap[key as keyof typeof siteMap];

            if (!target) return null;

            return (
                <a
	                class:list={['edge', `edge-${direction}`]}
	                href={target.path}
	                aria-label={`Go ${direction} to ${target.label}`}
                >
	                <span class="edge-content">
		                <span class="arrow">
							{direction === 'left' && <Fragment set:html="&larr;" />}
							{direction === 'right' && <Fragment set:html="&rarr;" />}
							{direction === 'up' && <Fragment set:html="&uarr;" />}
							{direction === 'down' && <Fragment set:html="&darr;" />}
						</span>

		                <span class="label">
			                {target.label}
		                </span>
	                </span>
                </a>
            );
        })
    }
</nav>

<style>
    .edge-nav {
        position: fixed;
        inset: 0;
        z-index: 40;
        pointer-events: none;
    }

    .edge {
	    position: absolute;
	    pointer-events: auto;
	    color: rgb(var(--gray-dark));
	    text-decoration: none;
	    opacity: 0;
        overflow: visible;

	    transition:
	    	opacity 0.25s ease,
	    	background 0.25s ease;
    }

    .edge:hover {
	    opacity: 1;
    }

    .edge-left,
    .edge-right {
	    top: 4rem;
	    bottom: 4rem;
	    width: 3rem;
    }

    .edge-left {
	    left: 0;
    }

    .edge-right {
	    right: 0;
    }

    .edge-up,
    .edge-down {
	    left: 22%;
	    right: 22%;
	    height: 3rem;
    }

    .edge-up {
	    top: 0;
    }

    .edge-down {
	    bottom: 0;
    }

    .edge-content {
	    position: absolute;
	    display: flex;
	    align-items: center;
	    gap: 0.5rem;

	    white-space: nowrap;
	    pointer-events: none;
    }

    .edge-left .edge-content {
	    left: 0.75rem;
	    top: 50%;
	    transform: translateY(-50%);
    }

    .edge-right .edge-content {
	    right: 0.75rem;
	    top: 50%;
	    transform: translateY(-50%);
    }

    .edge-up .edge-content {
	    left: 50%;
	    top: 0.75rem;
	    transform: translateX(-50%);
	    flex-direction: column;
	    gap: 0.2rem;
    }

    .edge-down .edge-content {
	    left: 50%;
	    bottom: 0.75rem;
	    transform: translateX(-50%);
	    flex-direction: column;
	    gap: 0.2rem;
    }

    .label {
	    font-size: clamp(0.62rem, 0.7vw, 0.78rem);
	    letter-spacing: 0.14em;
	    text-transform: uppercase;
	    white-space: nowrap;
    }

    .arrow {
    	font-size: clamp(1.2rem, 1.4vw, 1.6rem);
    	line-height: 1;
    }

    @media (max-width: 720px) {
	    .edge-left,
	    .edge-right {
	    	width: 2.5rem;
	    	top: 3rem;
	    	bottom: 3rem;
	    }

	    .edge-up,
	    .edge-down {
	    	left: 18%;
	    	right: 18%;
	    	height: 2.5rem;
	    }

	    .label {
	    	font-size: 0.6rem;
	    	letter-spacing: 0.1em;
	    }
    }
</style>