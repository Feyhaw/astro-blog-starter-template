
---
import { siteMap } from '../data/siteMap';

const currentPath =
    Astro.url.pathname.replace(/\/$/, '') || '/';

const currentEntry = Object.entries(siteMap).find(
    ([, page]) => {
        const pagePath =
            page.path.replace(/\/$/, '') || '/';

        if (pagePath === '/') {
            return currentPath === '/';
        }

        return (
            currentPath === pagePath ||
            currentPath.startsWith(`${pagePath}/`)
        );
    }
);

const currentKey = currentEntry?.[0];
---

<nav
    class="mini-map"
    aria-label="Navigate Capsule Fey"
>
    <!-- permanent 3 × 3 spatial frame -->
    <div class="mini-grid" aria-hidden="true">
        {
            Array.from({ length: 9 }).map(() => (
                <span class="grid-cell"></span>
            ))
        }
    </div>

    <!-- actual rooms -->
    <div class="mini-rooms">
        {
            Object.entries(siteMap).map(([key, page]) => (
                <a
                    href={page.path}
                    class:list={[
                        'mini-room',
                        key === currentKey && 'current',
                    ]}
                    style={`
                        --column: ${page.x + 2};
                        --row: ${page.y + 2};
                    `}
                    aria-label={`Go to ${page.label}`}
                    aria-current={
                        key === currentKey
                            ? 'page'
                            : undefined
                    }
                    title={page.label}
                ></a>
            ))
        }
    </div>
</nav>

<style>
    .mini-map {
        position: fixed;

        top: 1.5rem;
        right: 4.5rem;

        width: 5.6rem;
        height: 5.6rem;

        z-index: 35;

        pointer-events: none;

        opacity: 0.75;
    }

    .mini-grid,
    .mini-rooms {
        position: absolute;
        inset: 0;

        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(3, 1fr);

        gap: 0.2rem;
    }

    .mini-grid {
        pointer-events: none;
    }

    .mini-room {
        grid-column: var(--column);
        grid-row: var(--row);

        border:
            1px solid rgba(70, 80, 85, 0.42);

        background: rgba(255, 255, 255, 0.65);

        pointer-events: auto;
        cursor: pointer;

        text-decoration: none;

        transition:
            background 0.3s ease,
            transform 0.3s ease,
            opacity 0.3s ease,
            box-shadow 0.3s ease;
    }

    /* Hover: available rooms */

    .mini-room:hover {
        background: rgba(70, 80, 85, 0.22);

        transform: scale(1.18);

        box-shadow:
            0 0 0 2px rgba(70, 80, 85, 0.08);
    }

    /* Current room */

    .mini-room.current {
        background: rgba(70, 80, 85, 0.82);

        transform: scale(1.08);
    }

    .mini-room.current:hover {
        background: rgba(70, 80, 85, 0.95);

        transform: scale(1.18);
    }

    /* Keyboard accessibility */

    .mini-room:focus-visible {
        outline: 2px solid rgba(70, 80, 85, 0.9);
        outline-offset: 3px;
    }

    @media (max-width: 700px) {
        .mini-map {
            top: 1rem;
            right: 3.5rem;

            width: 4.6rem;
            height: 4.6rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .mini-room {
            transition: none;
        }
    }
</style>
