---

<div class="chapter-structure">
	{
		chapters.map((chapter) => (
			<section class="chapter-column">
				<header class="chapter-heading">
					<p>Thesis Structure</p>
					<h2>{chapter.title}</h2>
				</header>

				<div class="chapter-cards">
					{
						chapter.cards.map((card) => (
							<button
								class="chapter-card"
								type="button"
								data-chapter-card
								data-title={card.title}
								data-subtitle={card.subtitle}
								data-abstract={JSON.stringify(card.abstract)}
								data-category={card.category}
								data-year={card.year}
								data-keywords={JSON.stringify(card.keywords)}
							>
								<p class="card-category">
									{card.category}
								</p>

								<h3>{card.title}</h3>

								<p class="card-subtitle">
									{card.subtitle}
								</p>
							</button>
						))
					}
				</div>
			</section>
		))
	}

	<article
		class="chapter-expanded"
		data-expanded-card
		hidden
	>
		<button
			class="minimize"
			type="button"
			data-minimize
		>
			Minimize
		</button>

		<p
			class="expanded-category"
			data-expanded-category
		></p>

		<h2 data-expanded-title></h2>

		<p
			class="expanded-subtitle"
			data-expanded-subtitle
		></p>

		<div class="expanded-section">
			<h3>Abstract</h3>
			<div data-expanded-abstract></div>
		</div>

		<div class="metadata">
			<div>
				<h3>Year</h3>
				<p data-expanded-year></p>
			</div>

			<div>
				<h3>Keywords</h3>
				<p data-expanded-keywords></p>
			</div>
		</div>
	</article>

</div>

<script>
		const structures =
			document.querySelectorAll<HTMLElement>(
				'.chapter-structure'
			);

		structures.forEach((structure) => {
			const cards =
				structure.querySelectorAll<HTMLButtonElement>(
					'[data-chapter-card]'
				);

			const expanded =
				structure.querySelector<HTMLElement>(
					'[data-expanded-card]'
				);

			if (!expanded) return;

			const minimize =
				expanded.querySelector<HTMLButtonElement>(
					'[data-minimize]'
				);

			const title =
				expanded.querySelector<HTMLElement>(
					'[data-expanded-title]'
				);

			const subtitle =
				expanded.querySelector<HTMLElement>(
					'[data-expanded-subtitle]'
				);

			const abstract =
				expanded.querySelector<HTMLElement>(
					'[data-expanded-abstract]'
				);

			const category =
				expanded.querySelector<HTMLElement>(
					'[data-expanded-category]'
				);

			const year =
				expanded.querySelector<HTMLElement>(
					'[data-expanded-year]'
				);

			const keywords =
				expanded.querySelector<HTMLElement>(
					'[data-expanded-keywords]'
				);

			cards.forEach((card) => {
				card.addEventListener('click', () => {
					if (title) {
						title.textContent =
							card.dataset.title ?? '';
					}

					if (subtitle) {
						subtitle.textContent =
							card.dataset.subtitle ?? '';
					}	

					if (category) {
						category.textContent =
							card.dataset.category ?? '';
					}

					if (year) {
						year.textContent =
							card.dataset.year ?? '';
					}

					if (abstract) {
						try {
							const paragraphs = JSON.parse(
								card.dataset.abstract ?? '[]'
							);

							abstract.innerHTML = '';

							paragraphs.forEach(
								(paragraph: string) => {
									const p =
										document.createElement('p');

									p.textContent = paragraph;

									abstract.appendChild(p);
								}
							);
						} catch {
							abstract.textContent =
								card.dataset.abstract ?? '';
						}
					}

					if (keywords) {
						try {
							const values = JSON.parse(
								card.dataset.keywords ?? '[]'
							);

							keywords.textContent =
								values.join(' · ');
						} catch {
							keywords.textContent = '';
						}
					}

					expanded.hidden = false;
				});
			});

			minimize?.addEventListener('click', () => {
				expanded.hidden = true;
			});
		});
</script>

<style>
	.chapter-structure {
		position: relative;

		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));

		width: 100%;
		margin: 4rem auto 6rem;
	}

	.chapter-column {
		position: relative;
		padding: 0 1.5rem 2rem;
	}

	.chapter-column + .chapter-column {
		border-left:
			1px solid rgba(70, 80, 85, 0.18);
	}

	.chapter-heading {
		margin-bottom: 2rem;
		text-align: center;
	}

	.chapter-heading p {
		margin: 0 0 0.4rem;

		color: rgb(var(--gray));

		font-size: 0.62rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.chapter-heading h2 {
		margin: 0;

		font-size: 1rem;
		font-weight: 500;
	}

	.chapter-cards {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.chapter-card {
		width: 100%;
		min-height: 10rem;

		padding: 1.4rem;

		border:
			1px solid rgba(70, 80, 85, 0.14);

		border-radius: 0.65rem;

		background: rgba(255, 255, 255, 0.72);

		color: rgb(var(--gray-dark));

		text-align: left;
		font: inherit;

		cursor: pointer;

		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			background 0.2s ease;
	}

	.chapter-card:hover {
		transform: translateY(-0.2rem);

		background: rgba(255, 255, 255, 0.94);

		box-shadow:
			0 0.7rem 1.8rem
			rgba(30, 40, 45, 0.08);
	}

	.card-category {
		margin: 0 0 0.65rem;

		color: rgb(var(--gray));

		font-size: 0.62rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.chapter-card h3 {
		margin: 0;

		font-size: 1rem;
		line-height: 1.3;
	}

	.card-subtitle {
		margin: 0.45rem 0 0;

		color: rgb(var(--gray));

		font-size: 0.8rem;
		line-height: 1.45;
	}

	.chapter-expanded {
		position: fixed;

		left: 50%;
		top: 50%;

		transform: translate(-50%, -50%);

		z-index: 100;

		width: min(36rem, calc(100% - 2rem));
		max-height: 82vh;

		overflow-y: auto;

		padding: 2.25rem;

		background: rgba(255, 255, 255, 0.98);

		border:
			1px solid rgba(70, 80, 85, 0.18);

		border-radius: 0.75rem;

		box-shadow:
			0 1rem 3rem
			rgba(30, 40, 45, 0.14);
	}

	.chapter-expanded[hidden] {
		display: none;
	}

	.minimize {
		position: absolute;
		top: 1rem;
		right: 1rem;

		border: 0;
		background: transparent;

		color: rgb(var(--gray));

		font-size: 0.68rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;

		cursor: pointer;
	}

	.expanded-category {
		margin: 0 0 0.5rem;

		color: rgb(var(--gray));

		font-size: 0.65rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.chapter-expanded h2 {
		margin: 0 5rem 0.35rem 0;
	}

	.expanded-subtitle {
		margin: 0;

		color: rgb(var(--gray));
	}

	.expanded-section {
		margin-top: 2rem;
	}

	.expanded-section h3,
	.metadata h3 {
		margin: 0 0 0.45rem;

		font-size: 0.68rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	[data-expanded-abstract] p {
		margin: 0 0 1.15rem;
		line-height: 1.72;
	}

	[data-expanded-abstract] p:last-child {
		margin-bottom: 0;
	}

	.metadata {
		display: grid;
		grid-template-columns: 1fr 2fr;

		gap: 2rem;

		margin-top: 2rem;
	}

	.metadata p {
		margin: 0;
		line-height: 1.6;
	}

	@media (max-width: 700px) {
		.chapter-structure {
			display: block;
		}

		.chapter-column {
			padding: 0 0 3.5rem;
		}

		.chapter-column + .chapter-column {
			border-left: 0;

			border-top:
				1px solid rgba(70, 80, 85, 0.18);

			padding-top: 3rem;
		}

		.chapter-cards {
			gap: 1rem;
		}

		.chapter-card {
			min-height: auto;
		}

		.chapter-expanded {
			width: calc(100% - 1.5rem);
			max-height: 85vh;
			padding: 1.5rem;
		}

		.metadata {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}
</style>