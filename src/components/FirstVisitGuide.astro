<div
	class="first-visit-prompt"
	data-first-visit-prompt
>
	<button
		class="prompt-open"
		type="button"
		data-prompt-open
		aria-label="Open first-time visitor guide"
	>
		<span class="prompt-pulse" aria-hidden="true"></span>

		<span class="prompt-label">
			FIRST TIME VISITOR？
		</span>
	</button>

	<button
		class="prompt-dismiss"
		type="button"
		data-prompt-close
	>
		Don't show anymore
	</button>
</div>

<div
	class="first-visit-guide"
	data-first-visit-guide
	hidden
	aria-hidden="true"
>
	<div class="guide-backdrop"></div>

	<section
		class="guide-card"
		role="dialog"
		aria-modal="true"
		aria-labelledby="guide-title"
	>
		<button
			class="guide-close"
			type="button"
			data-guide-close
			aria-label="Close introduction"
		>
			×
		</button>

		<p class="guide-eyebrow">
			First time visitor?
		</p>

		<div class="guide-pages">

			<!-- STEP 1 -->
			<section
				class="guide-page active"
				data-guide-page="0"
			>
				<div class="guide-visual edge-demo">
					<span class="demo-screen"></span>

					<span class="demo-edge demo-up">
						↑
					</span>

					<span class="demo-edge demo-right">
						→
					</span>

					<span class="demo-edge demo-down">
						↓
					</span>

					<span class="demo-edge demo-left">
						←
					</span>
				</div>

				<div class="guide-copy">
					<p class="step-number">
						01
					</p>

					<h2 id="guide-title">
						Navigate the space
					</h2>

					<p>
						Move your cursor towards the edge of the screen
						to discover neighbouring spaces.
					</p>
				</div>
			</section>

			<!-- STEP 2 -->
			<section
				class="guide-page"
				data-guide-page="1"
				hidden
			>
				<div class="guide-visual librarian-demo">
					<div class="demo-question">
						Ask the Librarian...
					</div>

					<div class="demo-answer">
						Archive response
					</div>
				</div>

				<div class="guide-copy">
					<p class="step-number">
						02
					</p>

					<h2>
						Ask the Librarian
					</h2>

					<p>
						You may ask the AI Librarian questions about
						materials held within Capsule Fey.
					</p>

					<p class="guide-note">
						Its responses are generated from the archive
						and may not represent Fey's own views.
					</p>
				</div>
			</section>

			<!-- STEP 3 -->
			<section
				class="guide-page"
				data-guide-page="2"
				hidden
			>
				<div class="guide-visual map-demo">
					<div class="demo-map">
						<span></span>
						<span class="occupied"></span>
						<span></span>

						<span class="occupied"></span>
						<span class="occupied current"></span>
						<span class="occupied"></span>

						<span class="occupied"></span>
						<span class="occupied"></span>
						<span class="occupied"></span>
					</div>
				</div>

				<div class="guide-copy">
					<p class="step-number">
						03
					</p>

					<h2>
						Know where you are
					</h2>

					<p>
						The MiniMap shows your current location
						within Capsule Fey.
					</p>

					<p>
						More instructions can be found in the
						<a class="shortcut" href="/constitution/manual" style="color: rgb(var(--gray));">
							Manual
						</a>.
					</p>
				</div>
			</section>

		</div>

		<footer class="guide-footer">
			<div
	            class="guide-progress"
	            aria-label="Guide steps"
            >
	            <button
		            type="button"
		            class="active"
		            data-guide-dot="0"
		            aria-label="Go to step 1"
	            ></button>

	            <button
		            type="button"
		            data-guide-dot="1"
		            aria-label="Go to step 2"
	            ></button>

	            <button
		            type="button"
		            data-guide-dot="2"
		            aria-label="Go to step 3"
	            ></button>
            </div>

			<button
			    class="guide-next"
			    type="button"
			    data-guide-next
			>
				Next →
			</button>
		</footer>
	</section>
</div>

<script>
	const PROMPT_KEY =
		'capsule_first_visit_prompt_dismissed';

	const DEV_ALWAYS_SHOW = false;

	const prompt =
		document.querySelector<HTMLElement>(
			'[data-first-visit-prompt]'
		);

	const promptOpen =
		document.querySelector<HTMLButtonElement>(
			'[data-prompt-open]'
		);

	const promptClose =
		document.querySelector<HTMLButtonElement>(
			'[data-prompt-close]'
		);

	const guideElement =
		document.querySelector<HTMLElement>(
			'[data-first-visit-guide]'
		);

	if (guideElement) {
		const guide = guideElement;

		const pages =
			guide.querySelectorAll<HTMLElement>(
				'[data-guide-page]'
			);

		const progress =
			guide.querySelectorAll<HTMLButtonElement>(
				'[data-guide-dot]'
			);

		const nextButton =
			guide.querySelector<HTMLButtonElement>(
				'[data-guide-next]'
			);

		const closeButton =
			guide.querySelector<HTMLButtonElement>(
				'[data-guide-close]'
			);

		let currentPage = 0;

		function showPrompt() {
			if (!prompt) return;

			prompt.hidden = false;
		}

		function hidePrompt() {
			if (!prompt) return;

			prompt.hidden = true;
		}

		function showGuide() {
			guide.hidden = false;

			guide.setAttribute(
				'aria-hidden',
				'false'
			);

			document.body.classList.add(
				'guide-open'
			);
		}

		function hideGuide() {
			guide.hidden = true;

			guide.setAttribute(
				'aria-hidden',
				'true'
			);

			document.body.classList.remove(
				'guide-open'
			);
		}

		function renderPage() {
			pages.forEach((page, index) => {
				const isActive =
					index === currentPage;

				page.hidden = !isActive;

				page.classList.toggle(
					'active',
					isActive
				);
			});

			progress.forEach((dot, index) => {
				dot.classList.toggle(
					'active',
					index === currentPage
				);
			});

			if (nextButton) {
				nextButton.textContent =
					currentPage === pages.length - 1
						? 'Enter →'
						: 'Next →';
			}
		}

		function openGuide() {
			hidePrompt();

			currentPage = 0;

			renderPage();
			showGuide();
		}

		promptOpen?.addEventListener(
			'click',
			openGuide
		);

		promptClose?.addEventListener(
			'click',
			(event) => {
				event.stopPropagation();

				localStorage.setItem(
					PROMPT_KEY,
					'true'
				);

				hidePrompt();
			}
		);

		progress.forEach((dot, index) => {
			dot.addEventListener(
				'click',
				() => {
					currentPage = index;
					renderPage();
				}
			);
		});

		nextButton?.addEventListener(
			'click',
			() => {
				if (
					currentPage <
					pages.length - 1
				) {
					currentPage += 1;

					renderPage();

					return;
				}

				localStorage.setItem(
					PROMPT_KEY,
					'true'
				);

				hideGuide();
			}
		);

		closeButton?.addEventListener(
			'click',
			() => {
				hideGuide();
				showPrompt();
			}
		);

		const promptDismissed =
			localStorage.getItem(
				PROMPT_KEY
			) === 'true';

		renderPage();

		if (
			DEV_ALWAYS_SHOW ||
			!promptDismissed
		) {
			showPrompt();
		} else {
			hidePrompt();
		}
	}
</script>

