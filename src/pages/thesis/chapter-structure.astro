---
import SpatialNavigation from '../../components/SpatialNavigation.astro';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import ChapterStructure from '../../components/research/ChapterStructure.astro';

export const prerender = false;

const accessCookie =
	Astro.cookies.get('capsule_thesis_access');

const hasAccess =
	accessCookie?.value === 'granted';

if (!hasAccess) {
	return Astro.redirect('/thesis');
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Chapter Structure — Thesis | Capsule Fey"
			description="Interactive chapter structure of the thesis."
		/>
	</head>

	<body>
		<Header />

		<SpatialNavigation />

		<main class="thesis-tool">
			<header>
				<p class="eyebrow">Thesis Structure</p>
				<h1>Chapter Structure</h1>

				<p>
					An interactive overview of the three chapters
					and their internal research structure.
				</p>
			</header>

			<ChapterStructure />

			<a class="shortcut" href="/thesis">
				Return to "Thesis"
			</a>
		</main>
	</body>
</html>

<style>
	.thesis-tool {
		width: min(100% - 2rem, 76rem);
		margin: 0 auto;
		padding: 6rem 0;
	}

	.eyebrow {
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}

	.shortcut {
		color: rgb(var(--gray));
		text-decoration: none;
	}

	.shortcut:hover {
		color: rgb(var(--gray-dark));
	}
</style>